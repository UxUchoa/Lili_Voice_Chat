+    pub fn load(provider: &Provider, name: &str, public_key: &[u8]) -> Result<Identity, JsError> {
+        let signature_scheme = SignatureScheme::ED25519;
+        let keypair = SignatureKeyPair::read(provider.0.storage(), public_key, signature_scheme)
+            .ok_or_else(|| JsError::new("identity key not found in provider state"))?;
+        let credential = BasicCredential::new(name.bytes().collect());
+        let credential_with_key = CredentialWithKey {
+            credential: credential.into(),
+            signature_key: keypair.public().into(),
+        };
+        Ok(Identity {
+            credential_with_key,
+            keypair,
+        })
+    }
 }
 
