+    /// Export the complete OpenMLS provider state. The caller MUST encrypt
+    /// these bytes at rest because they contain device and group secrets.
+    pub fn export_state(&self) -> Result<Vec<u8>, JsError> {
+        let values = self
+            .0
+            .storage()
+            .values
+            .read()
+            .map_err(|_| JsError::new("storage lock poisoned"))?;
+        let mut output = Vec::new();
+        output.extend_from_slice(&(values.len() as u64).to_be_bytes());
+        for (key, value) in values.iter() {
+            output.extend_from_slice(&(key.len() as u64).to_be_bytes());
+            output.extend_from_slice(&(value.len() as u64).to_be_bytes());
+            output.extend_from_slice(key);
+            output.extend_from_slice(value);
+        }
+        Ok(output)
+    }
+
+    /// Restore a provider previously returned by `export_state`.
+    pub fn from_state(bytes: &[u8]) -> Result<Provider, JsError> {
+        let mut cursor = Cursor::new(bytes);
+        let read_u64 = |cursor: &mut Cursor<&[u8]>| -> Result<u64, JsError> {
+            let mut value = [0u8; 8];
+            cursor
+                .read_exact(&mut value)
+                .map_err(|_| JsError::new("truncated provider state"))?;
+            Ok(u64::from_be_bytes(value))
+        };
+        let count = read_u64(&mut cursor)? as usize;
+        if count > 100_000 {
+            return Err(JsError::new("provider state record limit exceeded"));
+        }
+        let mut values = HashMap::with_capacity(count);
+        for _ in 0..count {
+            let key_len = read_u64(&mut cursor)? as usize;
+            let value_len = read_u64(&mut cursor)? as usize;
+            if key_len > 1_048_576 || value_len > 16_777_216 {
+                return Err(JsError::new("provider state entry limit exceeded"));
+            }
+            let mut key = vec![0u8; key_len];
+            let mut value = vec![0u8; value_len];
+            cursor
+                .read_exact(&mut key)
+                .map_err(|_| JsError::new("truncated provider key"))?;
+            cursor
+                .read_exact(&mut value)
+                .map_err(|_| JsError::new("truncated provider value"))?;
+            values.insert(key, value);
+        }
+        if cursor.position() as usize != bytes.len() {
+            return Err(JsError::new("trailing provider state bytes"));
+        }
+        let provider = Provider::default();
+        *provider
+            .0
+            .storage()
+            .values
+            .write()
+            .map_err(|_| JsError::new("storage lock poisoned"))? = values;
+        Ok(provider)
+    }
 }
 
