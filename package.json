{
  "name": "lili-voice-chat",
  "private": true,
  "version": "0.1.4",
  "description": "Cliente local-first de mensagens cifradas, voz, vídeo e compartilhamento de tela.",
  "author": "Lili contributors",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "vite",
    "local:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-local.ps1",
    "local:serve": "concurrently -k -n web,functions \"vite --host 127.0.0.1\" \"supabase functions serve --env-file supabase/functions/.env.local\"",
    "local:up": "npm run local:prepare && npm run local:serve",
    "build": "vite build",
    "build:web": "node scripts/check-web-env.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src supabase/functions",
    "test:livekit": "node scripts/test-livekit-media.mjs",
    "test:workspace": "node scripts/test-shared-workspace.mjs",
    "test:chat": "playwright test",
    "test:db": "supabase test db && supabase db lint --local --schema public --level warning",
    "test:local": "npm run local:prepare && npm run test:workspace && npm run test:chat && npm run test:livekit && npm run test && npm run test:db && npm run typecheck && npm run build",
    "test:update-installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installed-update.ps1",
    "infra:livekit:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-livekit-local.ps1",
    "infra:livekit:up": "npm run infra:livekit:configure && docker compose -f infra/livekit/docker-compose.local.yml up -d --force-recreate livekit",
    "infra:livekit:down": "docker compose -f infra/livekit/docker-compose.local.yml down",
    "test:watch": "vitest src supabase/functions",
    "electron": "wait-on http://127.0.0.1:5173 && electron .",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:electron\"",
    "desktop:smoke": "electron scripts/test-desktop-smoke.mjs",
    "desktop:prod": "concurrently -k -n vite,electron \"vite --mode production --host 127.0.0.1\" \"npm:electron\"",
    "desktop:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "deploy:supabase": "node scripts/deploy-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.3",
    "@vitejs/plugin-react": "latest",
    "dexie": "^4.4.5",
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.22.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^0.13.34",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "livekit-server-sdk": "^2.17.0",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "productName": "Lili - Voice Chat",
    "appId": "chat.lili.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "logo-vetorizada.*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo-vetorizada.ico"
    },
    "artifactName": "Lili-Voice-Chat-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/logo-vetorizada.ico",
      "uninstallerIcon": "public/logo-vetorizada.ico"
    }
  }
}
