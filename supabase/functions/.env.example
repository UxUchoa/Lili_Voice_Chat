# Segredos das Edge Functions.
#
# Copie para `.env.production` (produção) ou `.env.local` (pilha local). Os
# dois são ignorados pelo git. Em produção:
#
#   npm run deploy:supabase -- --project-ref <ref>
#
# que chama `supabase secrets set --env-file supabase/functions/.env.production`.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Header `x-push-secret`, usado por schedule_push_dispatch.sql.
PUSH_DISPATCH_SECRET=
# Header `x-cron-secret`, usado por schedule_attachments_expire.sql.
ATTACHMENTS_EXPIRE_SECRET=
# Origens autorizadas, separadas por vírgula. `null` libera o desktop
# empacotado (file://). Curinga de subdomínio vale para as pré-visualizações.
ALLOWED_ORIGIN=https://janja.example.com,https://*.vercel.app,null
