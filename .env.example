# ============================================================================
# Frontend (Vercel → Settings → Environment Variables, ou .env.local no dev)
#
# Tudo com o prefixo VITE_ é embutido em texto puro no bundle e fica visível
# para qualquer visitante. Nunca coloque service-role key, segredo do LiveKit
# ou chave VAPID privada aqui — `npm run build:web` recusa o build se isso
# acontecer.
# ============================================================================
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_LIVEKIT_URL=wss://SEU_PROJETO.livekit.cloud
VITE_FORCE_TURN=false
VITE_VAPID_PUBLIC_KEY=
# A busca de GIFs usa o Giphy e a chave fica no SERVIDOR, não aqui: uma
# variável VITE_ é embutida no pacote público e qualquer pessoa a leria no
# devtools. Publique com:
#   supabase secrets set GIF_API_KEY=... --project-ref <ref>
# Para o ambiente local, coloque GIF_API_KEY em supabase/functions/.env.local.
# Endereço público do site, sem barra no fim. Na web pode ficar vazio: ali a
# origem da página já é o site. No desktop é obrigatório — o aplicativo
# instalado carrega o `dist/` por file://, onde `window.location.origin` vale
# a string "file://", e sem isto o convite copiado vira `file:///#/invite/CODE`
# e o link de recuperação de senha não tem para onde voltar.
VITE_SITE_URL=https://SEU_DOMINIO

# Publica o sourcemap junto com o site — entrega o código-fonte inteiro a quem
# abrir a página. Ligue só para depurar um build específico.
LILI_SOURCEMAP=false

# ============================================================================
# Segredos das Edge Functions
#
# Copie esta seção para `supabase/functions/.env.production` (ignorado pelo
# git) e envie com `npm run deploy:supabase`, que chama
# `supabase secrets set --env-file`. Para o ambiente local, o mesmo formato vai
# em `supabase/functions/.env.local`.
# ============================================================================
LIVEKIT_URL=wss://SEU_PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Autoriza o cron a chamar `push-dispatch`. Vai no header `x-push-secret`.
PUSH_DISPATCH_SECRET=
# Autoriza o cron a chamar `attachments-expire`. Vai no header `x-cron-secret`.
# Sem ele o anexo vencido só some quando alguém abre o aplicativo.
ATTACHMENTS_EXPIRE_SECRET=
# Autoriza o cron a chamar `accounts-prune`, o expurgo das contas paradas há
# 90 dias. Vai no header `x-cron-secret`. Sem ele o expurgo nunca roda.
ACCOUNTS_PRUNE_SECRET=
# Dias de inatividade antes da conta virar lápide. O padrão é 90.
ACCOUNTS_PRUNE_DAYS=90

# Origens que podem chamar as funções, separadas por vírgula. Precisa incluir
# o domínio de produção; `null` libera o desktop empacotado, que carrega o
# `dist/` por file:// e manda `Origin: null`. Aceita curinga de subdomínio para
# as pré-visualizações da Vercel.
#   ALLOWED_ORIGIN=https://lili.app,https://*.vercel.app,null
ALLOWED_ORIGIN=http://127.0.0.1:5173

# ============================================================================
# Ferramentas de deploy
# ============================================================================
# Ref do projeto Supabase (https://supabase.com/dashboard/project/<ref>).
SUPABASE_PROJECT_REF=

# Pipeline de release do Electron. O certificado vive nos secrets do GitHub.
GH_TOKEN=
CSC_LINK=
CSC_KEY_PASSWORD=
