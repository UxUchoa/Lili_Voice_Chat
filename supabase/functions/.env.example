# Segredos das Edge Functions.
#
# Copie para `.env.production` (produção) ou `.env.local` (pilha local). Os
# dois são ignorados pelo git. Em produção:
#
#   npm run deploy:supabase -- --project-ref <ref>
#
# que chama `supabase secrets set --env-file supabase/functions/.env.production`.
LIVEKIT_URL=wss://SEU_PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Header `x-push-secret`, usado por schedule_push_dispatch.sql.
PUSH_DISPATCH_SECRET=
# Header `x-cron-secret`, usado por schedule_attachments_expire.sql.
ATTACHMENTS_EXPIRE_SECRET=
# Autoriza o cron a chamar `accounts-prune`, o expurgo das contas paradas há
# 90 dias. Vai no header `x-cron-secret`. Sem ele o expurgo nunca roda.
ACCOUNTS_PRUNE_SECRET=
# Dias de inatividade antes da conta virar lápide. O padrão é 90.
ACCOUNTS_PRUNE_DAYS=90

# Chave da API do Giphy, usada pela função `gifs`. Fica aqui, e não numa
# variável VITE_, porque `VITE_` é embutida no pacote público: a chave apareceria
# no devtools e qualquer pessoa gastaria a cota. Sem ela o seletor de GIFs abre
# explicando o que falta, e o envio por anexo continua funcionando.
GIF_API_KEY=

# Origens autorizadas, separadas por vírgula. `null` libera o desktop
# empacotado (file://). Curinga de subdomínio vale para as pré-visualizações.
ALLOWED_ORIGIN=https://lili.example.com,https://*.vercel.app,null
